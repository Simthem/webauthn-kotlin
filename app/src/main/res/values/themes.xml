<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PqVault" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">#141517</item>
        <item name="android:navigationBarColor">#141517</item>
        <item name="android:windowBackground">#141517</item>
    </style>

    <!-- The credential activity only hosts system dialogs; it must not paint a screen. -->
    <style name="Theme.PqVault.Transparent" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
