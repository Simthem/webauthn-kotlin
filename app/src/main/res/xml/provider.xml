<?xml version="1.0" encoding="utf-8"?>
<!--
    Declares which credential types we can serve.

    Beware the asymmetry: the password type is namespaced android.credentials, but the
    passkey type is androidx.credentials. The system matches this string against the
    requested credential type, so the wrong prefix means passkey requests are silently
    never routed to us and the app simply never appears in the picker.

    Only passkeys are declared: passwords are KeePassDX's job, not ours.
-->
<!--
    settingsSubtitle is read from Android 14 onwards and ignored below it, which is the
    behaviour we want: the app still registers as a provider on Android 13, it simply
    shows no subtitle there. Declaring it is how Android 14 users get the label.
-->
<credential-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:settingsSubtitle="@string/provider_settings_subtitle"
    tools:ignore="UnusedAttribute">
    <capabilities>
        <capability name="androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
    </capabilities>
</credential-provider>
